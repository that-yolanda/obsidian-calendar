{
	"name": "ob-calendar",
	"version": "1.0.0",
	"description": "Obsidian Calendar",
	"main": "main.js",
	"type": "module",
	"author": "Yolanda",
	"packageManager": "pnpm@10.32.1",
	"homepage": "https://github.com/that-yolanda/obsidian-calendar",
